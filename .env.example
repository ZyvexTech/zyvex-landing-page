# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to git.

# Meta Pixel & Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=

# Zoho CRM OAuth (India DC — Self Client)
# Generate from: https://api-console.zoho.in  →  Self Client  →  Generate Code
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Qualified Deal conversions (api/zoho-deal-qualified.js)
# Separate refresh token from the same Self Client, generated with the scopes:
#   ZohoCRM.coql.READ, ZohoCRM.modules.leads.READ, ZohoCRM.modules.deals.READ,
#   ZohoCRM.modules.deals.WRITE, ZohoCRM.modules.contacts.READ
# ZOHO_REFRESH_TOKEN above (used by api/submit-lead.js) is left unchanged.
ZOHO_DEALS_REFRESH_TOKEN=
# Shared secret Zoho sends in the X-Zyvex-Webhook-Secret header (at least 32 random characters).
# Zoho webhook URL (keep the trailing slash; vercel.json redirects without it):
#   https://in.zyvextech.co/api/zoho-deal-qualified/
ZOHO_WEBHOOK_SECRET=
# Optional. Meta Events Manager test code, sent as test_event_code so events show under
# Test Events only. Set on Preview only; must stay unset in Production.
META_TEST_EVENT_CODE=

# Cross-browser Meta click handoff (api/attribution-handoff.js, zx_hid)
# Added automatically by the Vercel Upstash for Redis integration. Use the read/write
# REST token, not UPSTASH_KV_REST_API_READ_ONLY_TOKEN.
UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=
